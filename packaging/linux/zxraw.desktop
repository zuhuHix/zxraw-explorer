# Desktop entry for ZXraw Explorer. Installed as /usr/share/applications/zxraw.desktop in the
# .deb and as the top-level and usr/share/applications copies in the AppImage.
#
# MimeType is an OPTIONAL handler: it makes ZXraw Explorer offered in "Open With" for these
# types. It does not become the default by being installed; the user picks it (or sets it
# with xdg-mime / the desktop's file-type settings). The list is the photo and RAW types the
# viewer opens (forge-app default_app.rs: IMAGE_EXTS + RAW_EXTS minus NOT_VIEWABLE), mapped
# to shared-mime-info names, then the archive types (an archive opens as a folder), then
# inode/directory. Extensions with no shared-mime-info type are left out. The list must match
# forge-app default_app_linux.rs (menu_mime_types, checked by a unit test): Settings > Default
# app sets these types and writes the same entry for an AppImage.
#
# StartupWMClass=zxraw: winit's X11 default WM_CLASS is argv[0]'s file name ("zxraw"), and on
# Wayland the app sets the app id "zxraw" (crates/forge-app/src/main.rs), so both match this
# file. Exec uses %f: the app takes a local path (not a URI) and opens only the first one.
[Desktop Entry]
Type=Application
Version=1.5
Name=ZXraw Explorer
GenericName=Photo and RAW browser
Comment=Browse, view and organise photos and RAW files
Exec=zxraw %f
Icon=zxraw
Terminal=false
StartupNotify=true
StartupWMClass=zxraw
Categories=Graphics;Photography;
Keywords=photo;raw;image;viewer;camera;
MimeType=image/jpeg;image/png;image/tiff;image/webp;image/gif;image/bmp;image/heic;image/heif;image/avif;image/x-canon-cr2;image/x-canon-cr3;image/x-nikon-nef;image/x-nikon-nrw;image/x-sony-arw;image/x-sony-srf;image/x-sony-sr2;image/x-fuji-raf;image/x-olympus-orf;image/x-panasonic-rw2;image/x-adobe-dng;image/x-pentax-pef;application/zip;application/x-7z-compressed;application/vnd.rar;application/x-tar;application/x-compressed-tar;application/x-bzip2-compressed-tar;application/x-bzip1-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/x-lz4-compressed-tar;application/gzip;application/x-bzip2;application/x-xz;application/zstd;application/x-lz4;inode/directory;
